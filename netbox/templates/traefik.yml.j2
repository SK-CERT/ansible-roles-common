# {{ ansible_managed }}

entryPoints:
    web:
        address: ":80"
        http:
            redirections:
                entryPoint:
                    to: websecure
                    scheme: https

    websecure:
        address: ":443"
    traefik:
        address: ":9090"

accessLog: {}

# API is only on the endpoint "traefik" which is not exposed outside of the container
api:
    insecure: true
    dashboard: true

log:
    level: INFO

providers:
    docker:
        exposedByDefault: false
        network: traefik_net

    file:
        directory: /etc/traefik/dynamic
        watch: true
